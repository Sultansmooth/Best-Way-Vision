# Best Way Vision - Environment Variables Template
# Copy this file to .env and fill in your values

# ===================================
# Frontend Configuration
# ===================================
PORT=3001
NODE_ENV=production

# Backend API URL (uncomment when backend is ready)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================================
# Backend Configuration (Future)
# ===================================

# Database
# DATABASE_URL=postgresql://bestway:bestway_secure_password@localhost:5432/bestway_vision

# NVR Configuration
# NVR_IP=192.168.1.100
# NVR_USERNAME=admin
# NVR_PASSWORD=your_nvr_password
# NVR_RTSP_PORT=554

# SMTP Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@bestway.com
# SMTP_PASSWORD=your_smtp_password
# REPORT_RECIPIENTS=manager@bestway.com,dave@bestway.com

# AI/CV Configuration
# MODEL_PATH=/app/models
# CONFIDENCE_THRESHOLD=0.7

# Redis
# REDIS_URL=redis://localhost:6379
